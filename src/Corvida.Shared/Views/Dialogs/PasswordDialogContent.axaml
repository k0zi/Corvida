<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Corvida.Views.Dialogs.PasswordDialogContent"
             Width="380">

    <StackPanel Margin="20" Spacing="12" VerticalAlignment="Center">
        <TextBlock x:Name="PromptText" FontSize="14" TextWrapping="Wrap"/>
        <TextBox x:Name="PasswordBox" PasswordChar="•" KeyDown="PasswordBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="Cancel_Click" Classes="Basic"/>
            <Button x:Name="ConfirmButton" Content="Confirm" Click="Ok_Click" Classes="accent"/>
        </StackPanel>
    </StackPanel>
</UserControl>
