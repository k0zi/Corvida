<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Corvida.Views.Dialogs.ConfirmDialogContent"
             Width="360">

    <StackPanel Margin="20" Spacing="16" VerticalAlignment="Center">
        <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="No" Click="No_Click" Classes="Basic"/>
            <Button Content="Yes" Click="Yes_Click" Classes="Basic Danger"/>
        </StackPanel>
    </StackPanel>
</UserControl>
