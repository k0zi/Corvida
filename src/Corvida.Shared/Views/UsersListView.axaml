<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Corvida.ViewModels"
             xmlns:models="using:Corvida.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Corvida.Views.UsersListView"
             x:DataType="vm:UsersListViewModel">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0 0 0 16">
            <TextBlock Text="Users" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Command="{Binding AddUserCommand}" Classes="Flat" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                    <TextBlock Text="New User"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0 0 0 12"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#F03E3E"/>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Users}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:UserAccount">
                        <sukiUi:GlassCard Margin="0 0 0 10" Padding="16">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding UserName}" FontSize="12" Opacity="0.6"/>
                                </StackPanel>

                                <Border Grid.Column="1" VerticalAlignment="Center" Padding="8 3"
                                        CornerRadius="10" Background="#224C6EF5">
                                    <TextBlock Text="{Binding Role}" FontSize="12"/>
                                </Border>

                                <Border Grid.Column="2" VerticalAlignment="Center" Padding="8 3"
                                        CornerRadius="10" Background="#22F03E3E"
                                        IsVisible="{Binding IsLockedOut}">
                                    <TextBlock Text="Locked out" FontSize="12" Foreground="#F03E3E"/>
                                </Border>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Center">
                                    <Button Classes="Basic"
                                            Command="{Binding $parent[ItemsControl].((vm:UsersListViewModel)DataContext).EditUserCommand}"
                                            CommandParameter="{Binding}">
                                        <materialIcons:MaterialIcon Kind="Pencil" Width="18" Height="18"/>
                                    </Button>
                                    <Button Classes="Basic Danger"
                                            Command="{Binding $parent[ItemsControl].((vm:UsersListViewModel)DataContext).DeleteUserCommand}"
                                            CommandParameter="{Binding}">
                                        <materialIcons:MaterialIcon Kind="Delete" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </sukiUi:GlassCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
