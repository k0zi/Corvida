<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Corvida.ViewModels"
             xmlns:models="using:Corvida.Models"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="Corvida.Views.TaskPlanningView"
             x:DataType="vm:TaskPlanningViewModel">

    <!-- Shared by the task editor and the PERT page: the task's three-point estimate and the
         tasks it has to wait for. -->
    <StackPanel Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Text="Estimate (days)" FontWeight="Medium"/>
            <Grid ColumnDefinitions="*,8,*,8,*">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Optimistic" FontSize="12" Foreground="{DynamicResource RiceForegroundMutedBrush}"/>
                    <NumericUpDown Value="{Binding EstimateOptimistic}" Minimum="0" Increment="0.5" FormatString="0.##"
                                   IsReadOnly="{Binding IsReadOnly}" PlaceholderText="–" ShowButtonSpinner="False"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="Most likely" FontSize="12" Foreground="{DynamicResource RiceForegroundMutedBrush}"/>
                    <NumericUpDown Value="{Binding EstimateMostLikely}" Minimum="0" Increment="0.5" FormatString="0.##"
                                   IsReadOnly="{Binding IsReadOnly}" PlaceholderText="–" ShowButtonSpinner="False"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="2">
                    <TextBlock Text="Pessimistic" FontSize="12" Foreground="{DynamicResource RiceForegroundMutedBrush}"/>
                    <NumericUpDown Value="{Binding EstimatePessimistic}" Minimum="0" Increment="0.5" FormatString="0.##"
                                   IsReadOnly="{Binding IsReadOnly}" PlaceholderText="–" ShowButtonSpinner="False"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding ExpectedText}" FontSize="12" Foreground="{DynamicResource RiceForegroundMutedBrush}"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Prerequisites" FontWeight="Medium" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Command="{Binding AddPrerequisiteCommand}" Classes="Basic"
                        IsVisible="{Binding !IsReadOnly}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14"/>
                        <TextBlock Text="Add"/>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="None: this task can start right away."
                       IsVisible="{Binding !Prerequisites.Count}"
                       FontSize="12" Foreground="{DynamicResource RiceForegroundMutedBrush}"/>
            <ItemsControl ItemsSource="{Binding Prerequisites}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:KanbanTask">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0 2">
                            <materialIcons:MaterialIcon Kind="ArrowRightBottom" Width="14" Height="14" Margin="0 0 6 0"
                                                         Foreground="{DynamicResource RiceForegroundMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2"
                                    Command="{Binding $parent[ItemsControl].((vm:TaskPlanningViewModel)DataContext).RemovePrerequisiteCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding !$parent[ItemsControl].((vm:TaskPlanningViewModel)DataContext).IsReadOnly}"
                                    Classes="Basic" Width="24" Height="24" Padding="4"
                                    ToolTip.Tip="Remove prerequisite">
                                <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
