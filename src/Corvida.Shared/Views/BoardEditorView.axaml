<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls;assembly=KD.Avalonia.Rice"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Corvida.ViewModels"
             xmlns:models="using:Corvida.Models"
             xmlns:conv="using:Corvida.Converters"
             xmlns:avc="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Corvida.Views.BoardEditorView"
             x:DataType="vm:BoardEditorViewModel"
             d:DataContext="{x:Static vm:BoardEditorViewModel.DesignInstance}">

    <DockPanel Margin="16">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0 0 0 16">
            <Button Grid.Column="0" Command="{Binding GoBackCommand}" Classes="Basic" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16"/>
                    <TextBlock Text="Back"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Board.Name}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border IsVisible="{Binding IsReadOnly}" Background="#20808080" CornerRadius="4" Padding="8 2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="Archive" Width="14" Height="14"/>
                        <TextBlock Text="Archived (read-only)" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        IsVisible="{Binding !IsReadOnly}">
                <Button Command="{Binding ManageMembersCommand}" Classes="Basic" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="AccountGroup" Width="16" Height="16"/>
                        <TextBlock Text="Manage Members"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddGroupCommand}" Classes="accent" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                        <TextBlock Text="Add Group"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- Swimlanes: one lane per board member (plus Unassigned), one column per group. The
             header row above the lanes names the groups once, so the columns hide their own headers.
             CardMoving is handled in code-behind: the view model moves the task and persists it. -->
        <rice:RiceKanbanBoard ItemsSource="{Binding Rows}" ColumnHeaders="{Binding GroupCards}"
                              ShowColumnHeaders="False"
                              CanDragCards="{Binding !IsReadOnly}" ShowAddCardButton="{Binding !IsReadOnly}"
                              CardMoving="Board_CardMoving" CardActivated="Board_CardActivated"
                              AddCardRequested="Board_AddCardRequested">
            <rice:RiceKanbanBoard.Styles>
                <Style Selector="rice|RiceKanbanCard" x:DataType="models:KanbanTask">
                    <Setter Property="Accent" Value="{Binding Priority, Converter={x:Static conv:PriorityToBrushConverter.Instance}}"/>
                </Style>
            </rice:RiceKanbanBoard.Styles>

            <rice:RiceKanbanBoard.ColumnHeaderTemplate>
                <DataTemplate x:DataType="vm:GroupCardViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Command="{Binding DeleteGroupCommand}"
                                Classes="Basic" Width="26" Height="26" Padding="4"
                                ToolTip.Tip="Delete group" IsVisible="{Binding !IsReadOnly}">
                            <materialIcons:MaterialIcon Kind="Delete" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </rice:RiceKanbanBoard.ColumnHeaderTemplate>

            <rice:RiceKanbanBoard.LaneTemplate>
                <TreeDataTemplate x:DataType="vm:SwimlaneRowViewModel" ItemsSource="{Binding Cells}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True"
                                Background="{Binding ColorHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}">
                            <Image Source="{Binding AvatarDataUri, Converter={x:Static conv:Base64ToBitmapConverter.Instance}}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding AvatarDataUri, Converter={x:Static avc:ObjectConverters.IsNotNull}}"/>
                        </Border>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </TreeDataTemplate>
            </rice:RiceKanbanBoard.LaneTemplate>

            <rice:RiceKanbanBoard.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:SwimlaneCellViewModel" ItemsSource="{Binding Tasks}">
                    <TextBlock Text="{Binding Group.Name}"/>
                </TreeDataTemplate>
            </rice:RiceKanbanBoard.ItemTemplate>

            <rice:RiceKanbanBoard.CardTemplate>
                <DataTemplate x:DataType="models:KanbanTask">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top"
                                    IsVisible="{Binding !$parent[rice:RiceKanbanColumn].((vm:SwimlaneCellViewModel)DataContext).IsReadOnly}">
                            <Button Command="{Binding $parent[rice:RiceKanbanColumn].((vm:SwimlaneCellViewModel)DataContext).EditTaskCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="Basic" Width="24" Height="24" Padding="4"
                                    ToolTip.Tip="Edit task">
                                <materialIcons:MaterialIcon Kind="Pencil" Width="12" Height="12"/>
                            </Button>
                            <Button Command="{Binding $parent[rice:RiceKanbanColumn].((vm:SwimlaneCellViewModel)DataContext).TransferTaskCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="Basic" Width="24" Height="24" Padding="4"
                                    ToolTip.Tip="Move to group">
                                <materialIcons:MaterialIcon Kind="SwapHorizontal" Width="12" Height="12"/>
                            </Button>
                            <Button Command="{Binding $parent[rice:RiceKanbanColumn].((vm:SwimlaneCellViewModel)DataContext).AssignAgentCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="Basic" Width="24" Height="24" Padding="4"
                                    ToolTip.Tip="Assign to agent">
                                <materialIcons:MaterialIcon Kind="SwapVertical" Width="12" Height="12"/>
                            </Button>
                            <Button Command="{Binding $parent[rice:RiceKanbanColumn].((vm:SwimlaneCellViewModel)DataContext).DeleteTaskCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="Basic" Width="24" Height="24" Padding="4"
                                    ToolTip.Tip="Delete task">
                                <materialIcons:MaterialIcon Kind="Delete" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0 0 4 0" Spacing="4">
                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon Kind="{Binding Priority, Converter={x:Static conv:PriorityToIconConverter.Instance}}"
                                                             Foreground="{Binding Priority, Converter={x:Static conv:PriorityToBrushConverter.Instance}}"
                                                             Width="12" Height="12"/>
                                <TextBlock Text="{Binding Priority}" FontSize="11"
                                           Foreground="{DynamicResource RiceForegroundMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </rice:RiceKanbanBoard.CardTemplate>
        </rice:RiceKanbanBoard>
    </DockPanel>
</UserControl>
