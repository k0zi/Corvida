<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Corvida.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Corvida.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <!-- Opaque, full-bleed: this is a gate, not a dialog, so nothing behind it may be reachable. -->
    <Border Background="{DynamicResource SukiBackground}">
        <sukiUi:GlassCard Width="380" Padding="28"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="18">

                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <Image Width="72" Height="72" Source="/Assets/corvida.png"/>
                    <TextBlock Text="Sign in to Corvida" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="This server requires an account." FontSize="12" Opacity="0.6"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Username" FontWeight="Medium"/>
                    <TextBox x:Name="UserNameBox"
                             Text="{Binding UserName}"
                             PlaceholderText="you@example.com"
                             IsEnabled="{Binding !IsBusy}"
                             KeyDown="Field_KeyDown"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Password" FontWeight="Medium"/>
                    <TextBox x:Name="PasswordBox"
                             Text="{Binding Password}"
                             PasswordChar="•"
                             IsEnabled="{Binding !IsBusy}"
                             KeyDown="Field_KeyDown"/>
                </StackPanel>

                <Border IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Background="#22F03E3E" CornerRadius="6" Padding="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="16" Height="16"
                                                    Foreground="#F03E3E" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#F03E3E"/>
                    </StackPanel>
                </Border>

                <Button Command="{Binding SignInCommand}" Classes="Flat"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        IsEnabled="{Binding !IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Login" Width="16" Height="16"/>
                        <TextBlock Text="Sign in"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </sukiUi:GlassCard>
    </Border>
</UserControl>
