<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Button classes the views used under SukiUI, kept so the views did not all have to change:
      "Basic" is a borderless button that only shows a background on hover, "Danger" colours its
      text for destructive actions. The filled primary button is Rice's own "accent" class.
    -->
    <Style Selector="Button.Basic">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.Danger">
        <Setter Property="Foreground" Value="{DynamicResource RiceDangerBrush}" />
    </Style>
    <Style Selector="Button.Danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource RiceDangerBrush}" />
    </Style>
    <Style Selector="Button.Danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource RiceDangerBrush}" />
    </Style>
</Styles>
