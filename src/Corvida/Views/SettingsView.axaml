<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="using:Corvida.Converters"
             xmlns:services="using:Corvida.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Corvida.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Corvida.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid Margin="16" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
        <ScrollViewer Grid.Row="1" AllowAutoHide="True">
            <StackPanel Spacing="16">
                <sukiUi:GlassCard Padding="20" MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel Spacing="16">

                        <!-- Storage Mode -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Storage Mode" FontWeight="Medium" />
                            <TextBlock Text="Where boards and tasks are stored."
                                       FontSize="12" Opacity="0.6" />
                            <RadioButton Content="Local Folder" IsChecked="{Binding IsLocalFolder}" />
                            <RadioButton Content="Server Hosted" IsChecked="{Binding IsServerHosted}" />
                        </StackPanel>

                        <!-- Data Path — LocalFolder mode only -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsLocalFolder}">
                            <TextBlock Text="Data Path" FontWeight="Medium" />
                            <TextBlock Text="The folder where boards and tasks are stored."
                                       FontSize="12" Opacity="0.6" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding DataPath}" PlaceholderText="~/CorvidaData" />
                                <Button Grid.Column="1" Click="BrowseFolder_Click" Classes="Basic">
                                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Server URL — ServerHosted mode only -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsServerHosted}">
                            <TextBlock Text="Server URL" FontWeight="Medium" />
                            <TextBlock Text="Base URL of the Corvida API server (e.g. http://localhost:5000)."
                                       FontSize="12" Opacity="0.6" />
                            <TextBox Text="{Binding ServerUrl}" PlaceholderText="http://localhost:5000" />
                        </StackPanel>

                        <!-- Export — ServerHosted mode only -->
                        <Button IsVisible="{Binding IsServerHosted}"
                                Click="ExportToFolder_Click"
                                Classes="Basic" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Export" Width="16" Height="16" />
                                <TextBlock Text="Export to Local Folder..." />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SaveCommand}" Classes="Flat" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ContentSave" Width="16" Height="16" />
                                <TextBlock Text="Save Settings" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </sukiUi:GlassCard>

                <!-- Authentication — ServerHosted mode only -->
                <sukiUi:GlassCard Padding="20" MaxWidth="600" HorizontalAlignment="Left"
                                  IsVisible="{Binding IsServerHosted}">
                    <StackPanel Spacing="16">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Require Login" FontWeight="Medium" />
                            <TextBlock Text="Controls who can reach this Corvida server. Off by default: anyone who can reach it has full access."
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="10" IsVisible="{Binding AuthStateKnown}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Width="18" Height="18"
                                                            Kind="{Binding AuthRequired, Converter={x:Static conv:BoolToLockIconConverter.Instance}}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding AuthRequired, Converter={x:Static conv:BoolToAuthStateConverter.Instance}}" />
                            </StackPanel>

                            <Button IsVisible="{Binding !AuthRequired}"
                                    Command="{Binding EnableAuthCommand}" Classes="Flat"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="Lock" Width="16" Height="16" />
                                    <TextBlock Text="Turn on login" />
                                </StackPanel>
                            </Button>

                            <TextBlock IsVisible="{Binding !AuthRequired}" FontSize="12" Opacity="0.6"
                                       TextWrapping="Wrap"
                                       Text="Whoever turns this on first becomes the only administrator, so do it right after installing the server." />

                            <Button IsVisible="{Binding AuthRequired}"
                                    Command="{Binding DisableAuthCommand}" Classes="Basic Danger"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="LockOpenVariant" Width="16" Height="16" />
                                    <TextBlock Text="Turn off login and delete all users" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock IsVisible="{Binding AuthMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding AuthMessage}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

                    </StackPanel>
                </sukiUi:GlassCard>

                <!-- Access keys for non-interactive clients (MCP) -->
                <sukiUi:GlassCard Padding="20" MaxWidth="600" HorizontalAlignment="Left"
                                  IsVisible="{Binding CanManageApiKeys}">
                    <StackPanel Spacing="16">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Access Keys" FontWeight="Medium" />
                            <TextBlock Text="The MCP server cannot show a login screen, so it authenticates with a key you generate here."
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Shown once, right after creation: the raw key is never recoverable. -->
                        <Border IsVisible="{Binding NewApiKey, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Background="#2266A80F" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Copy this key now — it cannot be shown again."
                                           FontWeight="Medium" TextWrapping="Wrap" />
                                <SelectableTextBlock Text="{Binding NewApiKey}" FontFamily="monospace"
                                                     TextWrapping="Wrap" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding UseNewKeyForMcpCommand}" Classes="Flat">
                                        <TextBlock Text="Use for the MCP server" />
                                    </Button>
                                    <Button Command="{Binding DismissNewKeyCommand}" Classes="Basic">
                                        <TextBlock Text="Done" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding ApiKeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:ApiKeyInfo">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 6">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                            <TextBlock FontSize="11" Opacity="0.6"
                                                       Text="{Binding LastUsedAt, StringFormat='Last used: {0}'}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="Basic Danger"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RevokeApiKeyCommand}"
                                                CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="Delete" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Command="{Binding CreateApiKeyCommand}" Classes="Flat"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="KeyPlus" Width="16" Height="16" />
                                <TextBlock Text="Generate key" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </sukiUi:GlassCard>



                <sukiUi:GlassCard Padding="20" MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel Spacing="16">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Install Skills" FontWeight="Medium" />
                            <TextBlock Text="Install the Corvida Kanban skills into an AI tool's skills folder."
                                       FontSize="12" Opacity="0.6" />
                        </StackPanel>

                        <!-- Claude Code -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Claude Code" FontWeight="Medium" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding ClaudeCodeSkillsPath}" />
                                <Button Grid.Column="1" IsVisible="{Binding !ClaudeCodeSkillsInstalled}"
                                        Command="{Binding ToggleClaudeCodeSkillsCommand}" Classes="Flat">
                                    <TextBlock Text="Install" />
                                </Button>
                                <Button Grid.Column="1" IsVisible="{Binding ClaudeCodeSkillsInstalled}"
                                        Command="{Binding ToggleClaudeCodeSkillsCommand}" Classes="Basic Danger">
                                    <TextBlock Text="Uninstall" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- OpenCode -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="OpenCode" FontWeight="Medium" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding OpencodeSkillsPath}" />
                                <Button Grid.Column="1" IsVisible="{Binding !OpencodeSkillsInstalled}"
                                        Command="{Binding ToggleOpencodeSkillsCommand}" Classes="Flat">
                                    <TextBlock Text="Install" />
                                </Button>
                                <Button Grid.Column="1" IsVisible="{Binding OpencodeSkillsInstalled}"
                                        Command="{Binding ToggleOpencodeSkillsCommand}" Classes="Basic Danger">
                                    <TextBlock Text="Uninstall" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Hermes -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Hermes" FontWeight="Medium" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding HermesSkillsPath}" />
                                <Button Grid.Column="1" IsVisible="{Binding !HermesSkillsInstalled}"
                                        Command="{Binding ToggleHermesSkillsCommand}" Classes="Flat">
                                    <TextBlock Text="Install" />
                                </Button>
                                <Button Grid.Column="1" IsVisible="{Binding HermesSkillsInstalled}"
                                        Command="{Binding ToggleHermesSkillsCommand}" Classes="Basic Danger">
                                    <TextBlock Text="Uninstall" />
                                </Button>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </sukiUi:GlassCard>

                <sukiUi:GlassCard Padding="20" MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel Spacing="16">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Install Agents" FontWeight="Medium" />
                            <TextBlock Text="Install the current Corvida agents as Claude-Code-style subagents into an AI tool's agents folder."
                                       FontSize="12" Opacity="0.6" />
                        </StackPanel>

                        <!-- Claude Code -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Claude Code" FontWeight="Medium" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding ClaudeCodeAgentsPath}" />
                                <Button Grid.Column="1" IsVisible="{Binding !ClaudeCodeAgentsInstalled}"
                                        Command="{Binding ToggleClaudeCodeAgentsCommand}" Classes="Flat">
                                    <TextBlock Text="Install" />
                                </Button>
                                <Button Grid.Column="1" IsVisible="{Binding ClaudeCodeAgentsInstalled}"
                                        Command="{Binding ToggleClaudeCodeAgentsCommand}" Classes="Basic Danger">
                                    <TextBlock Text="Uninstall" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- OpenCode -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="OpenCode" FontWeight="Medium" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding OpencodeAgentsPath}" />
                                <Button Grid.Column="1" IsVisible="{Binding !OpencodeAgentsInstalled}"
                                        Command="{Binding ToggleOpencodeAgentsCommand}" Classes="Flat">
                                    <TextBlock Text="Install" />
                                </Button>
                                <Button Grid.Column="1" IsVisible="{Binding OpencodeAgentsInstalled}"
                                        Command="{Binding ToggleOpencodeAgentsCommand}" Classes="Basic Danger">
                                    <TextBlock Text="Uninstall" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Hermes -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Hermes" FontWeight="Medium" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding HermesAgentsPath}" />
                                <Button Grid.Column="1" IsVisible="{Binding !HermesAgentsInstalled}"
                                        Command="{Binding ToggleHermesAgentsCommand}" Classes="Flat">
                                    <TextBlock Text="Install" />
                                </Button>
                                <Button Grid.Column="1" IsVisible="{Binding HermesAgentsInstalled}"
                                        Command="{Binding ToggleHermesAgentsCommand}" Classes="Basic Danger">
                                    <TextBlock Text="Uninstall" />
                                </Button>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </sukiUi:GlassCard>

                <sukiUi:GlassCard Padding="20" MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel Spacing="16">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Install MCP Server" FontWeight="Medium" />
                            <TextBlock Text="Register the Corvida MCP server with an AI tool so it can manage your boards directly."
                                       FontSize="12" Opacity="0.6" />
                        </StackPanel>

                        <!-- Shared MCP project path -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="MCP Server Project Path" FontWeight="Medium" />
                            <TextBlock Text="Path to Corvida.Mcp.csproj, used when installing to any of the tools below."
                                       FontSize="12" Opacity="0.6" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding McpProjectPath}" PlaceholderText="/path/to/src/Corvida.Mcp/Corvida.Mcp.csproj" />
                                <Button Grid.Column="1" Click="BrowseMcpProject_Click" Classes="Basic">
                                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Claude Code -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Claude Code" FontWeight="Medium" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding ClaudeCodeMcpConfigPath}" />
                                <Button Grid.Column="1" IsVisible="{Binding !ClaudeCodeMcpInstalled}"
                                        Command="{Binding ToggleClaudeCodeMcpCommand}" Classes="Flat">
                                    <TextBlock Text="Install" />
                                </Button>
                                <Button Grid.Column="1" IsVisible="{Binding ClaudeCodeMcpInstalled}"
                                        Command="{Binding ToggleClaudeCodeMcpCommand}" Classes="Basic Danger">
                                    <TextBlock Text="Uninstall" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- OpenCode -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="OpenCode" FontWeight="Medium" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding OpencodeMcpConfigPath}" />
                                <Button Grid.Column="1" IsVisible="{Binding !OpencodeMcpInstalled}"
                                        Command="{Binding ToggleOpencodeMcpCommand}" Classes="Flat">
                                    <TextBlock Text="Install" />
                                </Button>
                                <Button Grid.Column="1" IsVisible="{Binding OpencodeMcpInstalled}"
                                        Command="{Binding ToggleOpencodeMcpCommand}" Classes="Basic Danger">
                                    <TextBlock Text="Uninstall" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Hermes -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Hermes" FontWeight="Medium" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding HermesMcpConfigPath}" />
                                <Button Grid.Column="1" IsVisible="{Binding !HermesMcpInstalled}"
                                        Command="{Binding ToggleHermesMcpCommand}" Classes="Flat">
                                    <TextBlock Text="Install" />
                                </Button>
                                <Button Grid.Column="1" IsVisible="{Binding HermesMcpInstalled}"
                                        Command="{Binding ToggleHermesMcpCommand}" Classes="Basic Danger">
                                    <TextBlock Text="Uninstall" />
                                </Button>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </sukiUi:GlassCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>