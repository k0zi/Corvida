<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Corvida.ViewModels"
             xmlns:models="using:Corvida.Models"
             xmlns:conv="using:Corvida.Converters"
             xmlns:avc="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Corvida.Views.BoardEditorView"
             x:DataType="vm:BoardEditorViewModel"
             d:DataContext="{x:Static vm:BoardEditorViewModel.DesignInstance}">

    <DockPanel Margin="16">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0 0 0 16">
            <Button Grid.Column="0" Command="{Binding GoBackCommand}" Classes="Basic" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16"/>
                    <TextBlock Text="Back"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Board.Name}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border IsVisible="{Binding IsReadOnly}" Background="#20808080" CornerRadius="4" Padding="8 2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="Archive" Width="14" Height="14"/>
                        <TextBlock Text="Archived (read-only)" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        IsVisible="{Binding !IsReadOnly}">
                <Button Command="{Binding ManageMembersCommand}" Classes="Basic" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="AccountGroup" Width="16" Height="16"/>
                        <TextBlock Text="Manage Members"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddGroupCommand}" Classes="Flat" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                        <TextBlock Text="Add Group"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <DockPanel MinWidth="300">
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding GroupCards}" Margin="150 0 0 8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupCardViewModel">
                            <sukiUi:GlassCard Width="280" Padding="12">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding GroupName}"
                                                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Command="{Binding DeleteGroupCommand}"
                                                Classes="Basic" Width="28" Height="28" Padding="4"
                                                IsVisible="{Binding !IsReadOnly}">
                                            <materialIcons:MaterialIcon Kind="Delete" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                    <Button DockPanel.Dock="Top" Command="{Binding AddTaskCommand}"
                                            HorizontalAlignment="Stretch" Margin="0 8 0 0" Classes="Basic"
                                            IsVisible="{Binding !IsReadOnly}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14"/>
                                            <TextBlock Text="Add Task" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </sukiUi:GlassCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SwimlaneRowViewModel">
                                <Grid ColumnDefinitions="150,*">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Top" Margin="0 8 8 0">
                                        <Border Width="28" Height="28" CornerRadius="14"
                                                Background="{Binding ColorHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}">
                                            <Image Source="{Binding AvatarDataUri, Converter={x:Static conv:Base64ToBitmapConverter.Instance}}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding AvatarDataUri, Converter={x:Static avc:ObjectConverters.IsNotNull}}"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"
                                                   TextWrapping="Wrap" MaxWidth="90" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="12"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SwimlaneCellViewModel">
                                                <sukiUi:GlassCard Width="280" MinHeight="72" Padding="12" VerticalAlignment="Top"
                                                    DragDrop.AllowDrop="{Binding !IsReadOnly}" Loaded="Cell_Loaded">
                                                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding Tasks}" Margin="0 0 0 4">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:KanbanTask">
                                                                    <Border Background="{Binding Priority, Converter={x:Static conv:PriorityToCardBackgroundConverter.Instance}}"
                                                                            CornerRadius="6" Margin="0 0 0 6" Padding="10 8"
                                                                            DoubleTapped="TaskCard_DoubleTapped" PointerPressed="TaskCard_PointerPressed">
                                                                        <DockPanel>
                                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                                                                                        IsVisible="{Binding !$parent[ItemsControl].((vm:SwimlaneCellViewModel)DataContext).IsReadOnly}">
                                                                                <Button Command="{Binding $parent[ItemsControl].((vm:SwimlaneCellViewModel)DataContext).EditTaskCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Classes="Basic" Width="26" Height="26" Padding="4"
                                                                                        ToolTip.Tip="Edit task">
                                                                                    <materialIcons:MaterialIcon Kind="Pencil" Width="12" Height="12"/>
                                                                                </Button>
                                                                                <Button Command="{Binding $parent[ItemsControl].((vm:SwimlaneCellViewModel)DataContext).TransferTaskCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Classes="Basic" Width="26" Height="26" Padding="4"
                                                                                        ToolTip.Tip="Move to group">
                                                                                    <materialIcons:MaterialIcon Kind="SwapHorizontal" Width="12" Height="12"/>
                                                                                </Button>
                                                                                <Button Command="{Binding $parent[ItemsControl].((vm:SwimlaneCellViewModel)DataContext).AssignAgentCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Classes="Basic" Width="26" Height="26" Padding="4"
                                                                                        ToolTip.Tip="Assign to agent">
                                                                                    <materialIcons:MaterialIcon Kind="SwapVertical" Width="12" Height="12"/>
                                                                                </Button>
                                                                                <Button Command="{Binding $parent[ItemsControl].((vm:SwimlaneCellViewModel)DataContext).DeleteTaskCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Classes="Basic" Width="26" Height="26" Padding="4"
                                                                                        ToolTip.Tip="Delete task">
                                                                                    <materialIcons:MaterialIcon Kind="Delete" Width="12" Height="12"/>
                                                                                </Button>
                                                                            </StackPanel>
                                                                            <StackPanel VerticalAlignment="Center" Margin="0 0 4 0">
                                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/>
                                                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0 2 0 0">
                                                                                    <materialIcons:MaterialIcon Kind="{Binding Priority, Converter={x:Static conv:PriorityToIconConverter.Instance}}"
                                                                                                                 Foreground="{Binding Priority, Converter={x:Static conv:PriorityToBrushConverter.Instance}}"
                                                                                                                 Width="12" Height="12"/>
                                                                                    <TextBlock Text="{Binding Priority}" FontSize="11" Opacity="0.7"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </DockPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </sukiUi:GlassCard>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
