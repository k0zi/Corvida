<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <Version>1.0.0</Version>
    </PropertyGroup>
    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>
    <ItemGroup>
        <None Include="Skills\**" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Agents\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.14">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
        <PackageReference Include="SukiUI" Version="7.0.1" />
    </ItemGroup>
    <ItemGroup>
      <Content Include=".local\shares\applications\Corvida.desktop" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\..\Corvida.Core\Corvida.Core.csproj" />
    </ItemGroup>

    <!-- Builds a self-contained linux-x64 .deb package after every Release publish. -->
    <Target Name="CreateDebPackage" AfterTargets="Publish"
            Condition="'$(Configuration)'=='Release' AND '$(SkipDebPackaging)'!='true' AND $([MSBuild]::IsOSPlatform('Linux'))">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c Release -r linux-x64 --self-contained true -p:SkipDebPackaging=true -o &quot;$(MSBuildProjectDirectory)/bin/Release/deb-staging&quot;" />
        <Exec Command="bash &quot;$(MSBuildProjectDirectory)/Packaging/build-deb.sh&quot; &quot;$(MSBuildProjectDirectory)/bin/Release/deb-staging&quot; $(Version) &quot;$(MSBuildProjectDirectory)/bin/Release/deb&quot; &quot;$(MSBuildProjectDirectory)&quot;" />
    </Target>
</Project>
