<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>
    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>
    <ItemGroup>
        <None Include="Skills\**" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Agents\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <!-- The Quadlet units the Settings page installs (PodmanServerInstaller). Embedded from packaging/quadlet/
             so the app and a manual install from the README use the very same files. -->
        <EmbeddedResource Include="..\..\packaging\quadlet\*" LogicalName="Corvida.Quadlet.%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.14">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
        <PackageReference Include="KD.Avalonia.Rice" Version="26.10.32" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>
    <ItemGroup>
      <Content Include=".local\shares\applications\Corvida.desktop" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Corvida.Core\Corvida.Core.csproj" />
      <ProjectReference Include="..\Corvida.Shared\Corvida.Shared.csproj" />
    </ItemGroup>

    <!-- A Release publish also builds the Linux package (desktop app + MCP server; .deb and .rpm)
         into artifacts/packages/ at the repository root. packaging/build-packages.sh is the real entry point
         and publishes each project itself, passing SkipLinuxPackaging=true so it does not recurse back here. -->
    <Target Name="CreateLinuxPackages" AfterTargets="Publish" Condition="'$(Configuration)'=='Release' AND '$(SkipLinuxPackaging)'!='true' AND $([MSBuild]::IsOSPlatform('Linux'))">
        <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../packaging/build-packages.sh&quot; --no-bump --skip-tests" />
    </Target>
</Project>
