<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rice="clr-namespace:KD.Avalonia.Rice;assembly=KD.Avalonia.Rice"
             xmlns:shared="clr-namespace:Corvida;assembly=Corvida.Shared"
             x:Class="Corvida.Web.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <shared:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <!-- Includes FluentTheme and the Material icon styles. -->
        <rice:RiceStyles />
        <StyleInclude Source="avares://Corvida.Shared/Styles/CorvidaStyles.axaml" />
    </Application.Styles>
</Application>
