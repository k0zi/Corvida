<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls;assembly=KD.Avalonia.Rice"
             xmlns:vm="clr-namespace:Corvida.ViewModels;assembly=Corvida.Shared"
             xmlns:dialogs="clr-namespace:Corvida.Views.Dialogs;assembly=Corvida.Shared"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="620"
             x:Class="Corvida.Web.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource RiceBackgroundBrush}">

    <Panel>
        <!-- No RiceWindow in the browser, so the theme toggle that lives in its title bar moves to
             the side menu's footer. -->
        <DockPanel IsVisible="{Binding IsSignedIn}">
            <rice:RiceSideMenu DockPanel.Dock="Left"
                               ItemsSource="{Binding Pages}"
                               SelectedItem="{Binding ActivePage, Mode=TwoWay}">
                <rice:RiceSideMenu.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageBase">
                        <TextBlock Text="{Binding MenuTitle}" />
                    </DataTemplate>
                </rice:RiceSideMenu.ItemTemplate>
                <rice:RiceSideMenu.Styles>
                    <Style Selector="rice|RiceSideMenuItem" x:DataType="vm:PageBase">
                        <Setter Property="Icon" Value="{Binding Icon}" />
                    </Style>
                    <!-- The automatic tool tip of the collapsed menu only works with a string Header. -->
                    <Style Selector="rice|RiceSideMenuItem:collapsed" x:DataType="vm:PageBase">
                        <Setter Property="ToolTip.Tip" Value="{Binding MenuTitle}" />
                    </Style>
                </rice:RiceSideMenu.Styles>
                <rice:RiceSideMenu.Footer>
                    <rice:RiceSideMenuItem Header="Toggle theme" Icon="{Binding ThemeIcon}"
                                           Command="{Binding ToggleThemeCommand}" />
                </rice:RiceSideMenu.Footer>
            </rice:RiceSideMenu>

            <ContentControl Content="{Binding ActivePage}" />
        </DockPanel>

        <!-- The browser host has no second window, so the gate has to be an overlay here too. -->
        <ContentControl Content="{Binding Login}" IsVisible="{Binding !IsSignedIn}"/>

        <dialogs:DialogHost DataContext="{Binding DialogManager}" />
    </Panel>
</UserControl>
