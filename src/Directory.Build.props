<Project>
  <!-- Version numbers come from version.json at the repository root (major = year, minor = month) plus the
       git height as patch, e.g. 26.11.3. The Dockerfiles copy individual project folders, not this file,
       so container builds are unaffected. -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" />
  </ItemGroup>
</Project>
