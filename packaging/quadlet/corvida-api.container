[Unit]
Description=Corvida API
Requires=corvida-db.service
After=corvida-db.service

[Container]
ContainerName=corvida-api
Image=ghcr.io/k0zi/corvida-api:latest
AutoUpdate=registry
Network=corvida.network
PodmanArgs=--network-alias=api
# Desktop and MCP clients connect here (Settings -> Server URL). The browser UI does not need this
# port: corvida-web proxies /api, /connect and /hubs to the API over the corvida network. Remove the
# line to keep the API reachable only through the web container.
PublishPort=5083:5083
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_HTTP_PORTS=5083
# No password in the connection string: Npgsql takes it from PGPASSWORD, which is filled from the same
# secret the database was initialised with.
Environment=ConnectionStrings__CorvidaApi=Host=db;Database=corvida;Username=postgres
Secret=corvida-db-password,type=env,target=PGPASSWORD
# Browser origins allowed to call the API directly. The bundled web UI is same-origin and needs no
# entry; list any other origin a browser client is served from.
Environment=Auth__AllowedOrigins__0=http://localhost:5180
# Plain HTTP between client and API, so OpenIddict's transport-security check is relaxed. Put a
# TLS-terminating proxy in front before exposing port 5083 beyond the local network.
Environment=Auth__AllowInsecureTransport=true

[Service]
# Startup migrations retry while PostgreSQL comes up; if they still give up, systemd starts over.
Restart=always
RestartSec=5
# The first start pulls the image, which can take far longer than systemd's default 90 s start timeout.
TimeoutStartSec=900

[Install]
WantedBy=default.target
